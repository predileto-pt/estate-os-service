# Terraform — local provider/module cache, state backups, plan output.
# `.terraform.lock.hcl` is the only thing here that SHOULD be tracked
# (provider version pins). The S3 backend means we never have local
# state files; the patterns below cover them anyway in case someone
# runs `terraform state pull > file`.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
!*.example.tfvars

# Lambda CI build artifacts (created by .github/workflows/deploy.yml
# during a push; might appear locally if someone runs the same
# commands by hand). Also the placeholder zip generated by terraform's
# `data.archive_file.lambda_placeholder`.
lambda-app.zip
lambda-deps.zip
lambda-placeholder.zip
