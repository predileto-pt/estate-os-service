# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Resend
RESEND_API_KEY=re_your_api_key

# AWS / LocalStack
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_DOMAIN_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/domain-events
SQS_PROPERTY_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/property-extraction-queue
SQS_APPLICANT_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/document-extraction-queue
SQS_APPLICANT_SCREENING_QUEUE_URL=http://localhost:4566/000000000000/screening-assessment-queue

# Database (direct PostgreSQL connection for Alembic migrations)
# DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:54322/postgres

# App
APP_ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
