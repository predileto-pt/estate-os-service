# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Resend
RESEND_API_KEY=re_your_api_key

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# AWS / LocalStack
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 Buckets
S3_BUCKET_NAME=property-documents
CONTRACT_S3_BUCKET_NAME=contract-intelligence-documents

# SNS — Domain events fan-out (ADR-008). Topic ARN is resolved per event type
# as `${prefix}${event_type with dots→dashes}`.
SNS_DOMAIN_EVENTS_TOPIC_ARN_PREFIX=arn:aws:sns:us-east-1:000000000000:domain-events-

# SQS — Per-context domain-event queues (each subscribed to the SNS topics it
# handles). Run one worker per context — see README.
SQS_CUSTOMERS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/customers-events-queue
SQS_BOOKINGS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/bookings-events-queue
SQS_PROPERTIES_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/properties-events-queue
SQS_LISTINGS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/listings-events-queue

# SQS — Property Extraction (internal pipeline)
SQS_PROPERTY_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/property-extraction-queue
SQS_PROPERTY_ENRICHMENT_QUEUE_URL=http://localhost:4566/000000000000/property-enrichment-queue
SQS_PROPERTY_ENRICHMENT_DLQ_URL=http://localhost:4566/000000000000/property-enrichment-dlq

# SQS — Applicant Screening (internal pipeline)
SQS_APPLICANT_EXTRACTION_QUEUE_URL=http://localhost:4566/000000000000/applicant-extraction-queue
SQS_APPLICANT_SCREENING_QUEUE_URL=http://localhost:4566/000000000000/applicant-screening-queue

# SQS — Contract Intelligence (internal pipeline)
SQS_CONTRACT_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/contract-ingestion-queue
SQS_CONTRACT_ANALYSIS_QUEUE_URL=http://localhost:4566/000000000000/contract-analysis-queue
SQS_CONTRACT_INGESTION_DLQ_URL=http://localhost:4566/000000000000/contract-ingestion-dlq
SQS_CONTRACT_ANALYSIS_DLQ_URL=http://localhost:4566/000000000000/contract-analysis-dlq

# Applicant Screening — Encryption (RSA + HMAC for NIF at rest)
# ENCRYPTION_PUBLIC_KEY=base64-encoded-pem
# ENCRYPTION_PRIVATE_KEY=base64-encoded-pem
# ENCRYPTION_HMAC_KEY=base64-encoded-key
MAX_APPLICANT_DOCUMENTS=5

# Booking Management
# BOOKING_TOKEN_SECRET=your-hs256-secret
# BOOKING_LINK_URL=https://portal.predileto.com/book

# Reducto (OCR for applicant screening + contract intelligence)
# REDUCTO_API_KEY=your-reducto-api-key

# Google Maps (property amenity discovery)
# GOOGLE_MAPS_API_KEY=your-google-maps-key

# Database (direct PostgreSQL connection for Alembic migrations)
# DATABASE_URL=postgresql+asyncpg://postgres:password@127.0.0.1:54322/postgres

# Observability
# LOGFIRE_TOKEN=your-logfire-token
# LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
# LANGFUSE_SECRET_KEY=your-langfuse-secret-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Stripe billing (see README § Stripe Billing Setup)
# Secret key — sandbox uses sk_test_..., prod uses sk_live_...
# STRIPE_API_KEY=sk_test_your_key_here
# Signing secret for the webhook endpoint (whsec_...).
# Local dev tip: `stripe listen --forward-to http://localhost:8000/api/v1/billing/webhooks/stripe`
# prints this value to the terminal when the listener starts.
# STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
# Price IDs for the four recurring plans. Create two products (Pro + Enterprise) in
# the Stripe Dashboard, each with a monthly and a yearly recurring EUR price, then
# paste the four `price_*` IDs here.
# STRIPE_PRICE_PRO_MONTHLY=price_your_pro_monthly_id
# STRIPE_PRICE_PRO_YEARLY=price_your_pro_yearly_id
# STRIPE_PRICE_ENTERPRISE_MONTHLY=price_your_enterprise_monthly_id
# STRIPE_PRICE_ENTERPRISE_YEARLY=price_your_enterprise_yearly_id
# Free-trial length passed to Checkout sessions (default 7).
# STRIPE_TRIAL_PERIOD_DAYS=7

# App
APP_ENV=development
LOG_LEVEL=debug
# Frontend base URL used to build Stripe Checkout success / cancel + Customer Portal
# return URLs. Dev default: 4000 (agencies-dashboard). Override for staging / prod.
APP_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
